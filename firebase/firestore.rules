rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOrganization() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId is string;
    }

    function isAdmin() {
      return hasOrganization()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return hasOrganization()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }

    function isEmployee() {
      return hasOrganization()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }

    // Future tenant helper. Business documents must include organizationId, and future
    // collection rules will compare that value with the authenticated user's profile.
    function sameOrganization(organizationId) {
      return hasOrganization()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId;
    }

    function canManageWebJobs() {
      return isAdmin() || isManager();
    }

    function isAssignedEmployeeJob(data) {
      return isEmployee()
        && data.isActive == true
        && request.auth.uid in data.assignedEmployeeIds
        && sameOrganization(data.organizationId);
    }

    function canEmployeeReadJob(data) {
      return isAssignedEmployeeJob(data);
    }

    function canEmployeeUpdateJobStatus() {
      return isAssignedEmployeeJob(resource.data)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.assignedEmployeeIds == resource.data.assignedEmployeeIds
        && request.resource.data.assignedAt == resource.data.assignedAt
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.priority == resource.data.priority
        && request.resource.data.statusUpdatedBy == request.auth.uid
        && request.resource.data.statusUpdatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          (
            resource.data.status == 'assigned'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.startedAt is timestamp
            && request.resource.data.startedBy == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'status',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'updatedAt',
              'startedAt',
              'startedBy'
            ])
          )
          || (
            resource.data.status == 'in_progress'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt is timestamp
            && request.resource.data.completedBy == request.auth.uid
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'status',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'updatedAt',
              'completedAt',
              'completedBy'
            ])
          )
        );
    }

    function employeeCanAccessJobId(jobId) {
      return exists(/databases/$(database)/documents/jobs/$(jobId))
        && isAssignedEmployeeJob(get(/databases/$(database)/documents/jobs/$(jobId)).data);
    }

    function isActiveEmployeeProfile(data) {
      return data.isActive == true
        && data.role == 'employee'
        && data.organizationId is string;
    }

    function hasStandardBusinessFields(data) {
      return data.id is string
        && data.organizationId is string
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isAllowedOverrideReason(reason) {
      return reason == 'Better local availability'
        || reason == 'Customer requested this employee'
        || reason == 'Special experience required'
        || reason == 'Workload balancing'
        || reason == 'Recommended employee unavailable'
        || reason == 'Manager preference'
        || reason == 'Other';
    }

    function isAllowedStatusTransition(fromStatus, toStatus) {
      return (fromStatus == 'draft' && (toStatus == 'open' || toStatus == 'cancelled'))
        || (fromStatus == 'open' && (toStatus == 'assigned' || toStatus == 'cancelled'))
        || (fromStatus == 'assigned' && (toStatus == 'open' || toStatus == 'in_progress' || toStatus == 'cancelled'))
        || (fromStatus == 'in_progress' && (toStatus == 'completed' || toStatus == 'cancelled'));
    }

    match /users/{uid} {
      allow get: if isOwnProfile(uid)
        || (canManageWebJobs()
          && isActiveEmployeeProfile(resource.data)
          && sameOrganization(resource.data.organizationId));
      allow list: if canManageWebJobs()
        && isActiveEmployeeProfile(resource.data)
        && sameOrganization(resource.data.organizationId);
      allow create: if false;
      allow update: if isOwnProfile(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // Jobs are stored in the jobs collection.
    // Phase 13B allows Admin and Manager to create and list active jobs only
    // within their own organization. Update, delete, assignment, audit log,
    // notification, and AI workflow rules will be added in later phases.
    // - Employee mobile access will be limited to assigned jobs only.
    match /jobs/{jobId} {
      allow get, list: if (
        canManageWebJobs()
        && resource.data.isActive == true
        && sameOrganization(resource.data.organizationId)
      ) || canEmployeeReadJob(resource.data);
      allow create: if canManageWebJobs()
        && hasStandardBusinessFields(request.resource.data)
        && request.resource.data.id == jobId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.statusUpdatedAt == null
        && request.resource.data.statusUpdatedBy == null
        && request.resource.data.assignedEmployeeIds == []
        && request.resource.data.assignedAt == null
        && request.resource.data.assignedBy == null
        && request.resource.data.workProofCount == 0
        && request.resource.data.issueCount == 0
        && request.resource.data.manualOverride == false
        && request.resource.data.isActive == true
        && sameOrganization(request.resource.data.organizationId);
      allow update: if (
        canManageWebJobs()
          && resource.data.isActive == true
          && sameOrganization(resource.data.organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && (
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'status',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'updatedAt'
            ])
            && request.resource.data.statusUpdatedBy == request.auth.uid
            && request.resource.data.statusUpdatedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.status != 'assigned'
            && isAllowedStatusTransition(resource.data.status, request.resource.data.status)
          )
          || (
            resource.data.status == 'open'
            && request.resource.data.status == 'assigned'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'assignedEmployeeIds',
              'assignedAt',
              'assignedBy',
              'status',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'updatedAt'
            ])
            && request.resource.data.assignedEmployeeIds is list
            && request.resource.data.assignedEmployeeIds.size() > 0
            && request.resource.data.assignedEmployeeIds.toSet().size()
              == request.resource.data.assignedEmployeeIds.size()
            && request.resource.data.assignedAt is timestamp
            && request.resource.data.assignedBy == request.auth.uid
            && request.resource.data.statusUpdatedAt is timestamp
            && request.resource.data.statusUpdatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp
          )
          || (
            resource.data.status == 'assigned'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'assignedEmployeeIds',
              'assignedAt',
              'assignedBy',
              'status',
              'statusUpdatedAt',
              'statusUpdatedBy',
              'updatedAt'
            ])
            && request.resource.data.statusUpdatedAt is timestamp
            && request.resource.data.statusUpdatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp
            && (
              (
                request.resource.data.status == 'assigned'
                && request.resource.data.assignedEmployeeIds is list
                && request.resource.data.assignedEmployeeIds.size() > 0
                && request.resource.data.assignedEmployeeIds.toSet().size()
                  == request.resource.data.assignedEmployeeIds.size()
                && request.resource.data.assignedAt is timestamp
                && request.resource.data.assignedBy == request.auth.uid
              )
              || (
                request.resource.data.status == 'open'
                && request.resource.data.assignedEmployeeIds == []
                && request.resource.data.assignedAt == null
                && request.resource.data.assignedBy == null
              )
            )
          )
        )
      ) || canEmployeeUpdateJobStatus();
      allow delete: if false;
    }

    match /jobActivities/{activityId} {
      allow get, list: if canManageWebJobs()
        && resource.data.isActive == true
        && sameOrganization(resource.data.organizationId);
      allow create: if (
        canManageWebJobs()
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == activityId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.jobId is string
          && (
            (
              request.resource.data.type == 'status_changed'
              && isAllowedStatusTransition(
                request.resource.data.fromStatus,
                request.resource.data.toStatus
              )
              && request.resource.data.toStatus != 'assigned'
            )
            || (
              request.resource.data.type == 'employees_assigned'
              && request.resource.data.fromStatus == 'open'
              && request.resource.data.toStatus == 'assigned'
              && request.resource.data.employeeIds is list
              && request.resource.data.employeeIds.size() > 0
              && request.resource.data.employeeIds.toSet().size()
                == request.resource.data.employeeIds.size()
              && request.resource.data.employeeNames is list
            )
            || (
              request.resource.data.type == 'employees_reassigned'
              && request.resource.data.fromStatus == 'assigned'
              && request.resource.data.toStatus == 'assigned'
              && request.resource.data.employeeIds is list
              && request.resource.data.employeeIds.size() > 0
              && request.resource.data.employeeIds.toSet().size()
                == request.resource.data.employeeIds.size()
              && request.resource.data.employeeNames is list
            )
            || (
              request.resource.data.type == 'employees_unassigned'
              && request.resource.data.fromStatus == 'assigned'
              && request.resource.data.toStatus == 'open'
              && request.resource.data.employeeIds == []
              && request.resource.data.employeeNames == []
            )
          )
          && sameOrganization(request.resource.data.organizationId)
      ) || (
        isEmployee()
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == activityId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.performedAt is timestamp
          && request.resource.data.performedBy == request.auth.uid
          && request.resource.data.employeeId == request.auth.uid
          && request.resource.data.jobId is string
          && employeeCanAccessJobId(request.resource.data.jobId)
          && (
            (
              request.resource.data.type == 'employee_started_job'
              && request.resource.data.fromStatus == 'assigned'
              && request.resource.data.toStatus == 'in_progress'
            )
            || (
              request.resource.data.type == 'employee_completed_job'
              && request.resource.data.fromStatus == 'in_progress'
              && request.resource.data.toStatus == 'completed'
            )
          )
          && sameOrganization(request.resource.data.organizationId)
      );
      allow update, delete: if false;
    }

    // Future teams rules:
    // - Team data is stored in users, not a separate teams collection.
    // - Admin and Manager team access will be handled through scoped users queries.
    // - Rules will enforce organizationId and RBAC before enabling list access.

    // Recommendation history is append-only in Phase 13K.
    // Admin and Manager can create/read recommendation records for their organization.
    // Employees cannot access recommendation history in the web phase.
    match /recommendations/{recommendationId} {
      allow get, list: if canManageWebJobs()
        && resource.data.isActive == true
        && sameOrganization(resource.data.organizationId);
      allow create: if canManageWebJobs()
        && hasStandardBusinessFields(request.resource.data)
        && request.resource.data.id == recommendationId
        && request.resource.data.jobId is string
        && request.resource.data.generatedBy == request.auth.uid
        && request.resource.data.generatedAt is timestamp
        && (request.resource.data.algorithmVersion == 'rule-based-v1' || request.resource.data.algorithmVersion == 'ahp-topsis-v1')
        && request.resource.data.assignmentMode == 'ai_recommendation'
        && request.resource.data.status == 'generated'
        && request.resource.data.candidates is list
        && request.resource.data.candidates.size() <= 5
        && sameOrganization(request.resource.data.organizationId);
      allow update: if canManageWebJobs()
        && resource.data.isActive == true
        && resource.data.status == 'generated'
        && sameOrganization(resource.data.organizationId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'decidedAt',
          'decidedBy',
          'decision',
          'overrideNote',
          'overrideReason',
          'recommendedEmployeeId',
          'recommendationCriteriaSnapshot',
          'recommendationScoreSnapshot',
          'selectedEmployeeId',
          'status',
          'updatedAt'
        ])
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.generatedBy == resource.data.generatedBy
        && request.resource.data.generatedAt == resource.data.generatedAt
        && request.resource.data.algorithmVersion == resource.data.algorithmVersion
        && request.resource.data.assignmentMode == resource.data.assignmentMode
        && request.resource.data.candidates == resource.data.candidates
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.recommendedEmployeeId is string
        && request.resource.data.selectedEmployeeId is string
        && request.resource.data.recommendationScoreSnapshot is number
        && request.resource.data.recommendationCriteriaSnapshot is map
        && (
          (
            request.resource.data.decision == 'accepted'
            && request.resource.data.status == 'accepted'
            && request.resource.data.selectedEmployeeId == request.resource.data.recommendedEmployeeId
            && request.resource.data.overrideReason == null
            && request.resource.data.overrideNote == null
          )
          || (
            request.resource.data.decision == 'overridden'
            && request.resource.data.status == 'overridden'
            && request.resource.data.selectedEmployeeId != request.resource.data.recommendedEmployeeId
            && isAllowedOverrideReason(request.resource.data.overrideReason)
            && (
              (
                request.resource.data.overrideReason == 'Other'
                && (
                  request.resource.data.overrideNote == null
                  || request.resource.data.overrideNote is string
                )
              )
              || (
                request.resource.data.overrideReason != 'Other'
                && request.resource.data.overrideNote == null
              )
            )
          )
        );
      allow delete: if false;
    }

    // Durable critical-action proposals are created by the requesting manager
    // and executed only by the trusted server-side callable function.
    match /actionProposals/{proposalId} {
      allow get, list: if canManageWebJobs()
        && resource.data.isActive == true
        && resource.data.requestedBy == request.auth.uid
        && sameOrganization(resource.data.organizationId);
      allow create: if canManageWebJobs()
        && hasStandardBusinessFields(request.resource.data)
        && request.resource.data.id == proposalId
        && request.resource.data.organizationId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.actionType == 'create_job'
        && request.resource.data.status == 'prepared'
        && request.resource.data.version == 1
        && request.resource.data.requiresConfirmation == true
        && request.resource.data.payload is map
        && request.resource.data.payloadHash is string
        && request.resource.data.summary is string
        && request.resource.data.warnings is list
        && request.resource.data.warnings.size() <= 5
        && request.resource.data.idempotencyKey == 'create_job:' + proposalId
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.confirmedAt == null
        && request.resource.data.processingStartedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.resultJobId == null
        && request.resource.data.failureCode == null
        && request.resource.data.failureSummary == null
        && request.resource.data.isActive == true;
      allow update, delete: if false;
    }

    // Incidents rules:
    // - Rules require sameOrganization(resource.data.organizationId).
    // - Employee mobile writes are limited to issues for assigned jobs.
    // - Admin and Manager can read and resolve incidents from the web portal.
    match /incidents/{incidentId} {
      allow create: if (
        isEmployee()
          && sameOrganization(request.resource.data.organizationId)
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == incidentId
          && request.resource.data.reportedByUserId == request.auth.uid
          && employeeCanAccessJobId(request.resource.data.jobId)
          && request.resource.data.status == 'open'
      ) || (
        canManageWebJobs()
          && sameOrganization(request.resource.data.organizationId)
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == incidentId
      );

      allow read: if (
        sameOrganization(resource.data.organizationId)
          && (canManageWebJobs() || resource.data.reportedByUserId == request.auth.uid)
      );

      allow update: if (
        canManageWebJobs()
          && sameOrganization(resource.data.organizationId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.updatedAt is timestamp
      );

      allow delete: if false;
    }

    // Future auditLogs rules:
    // - Audit logs are append-only.
    // - Rules require sameOrganization(resource.data.organizationId).
    // - Read access is limited to Admin and Manager dashboard/reporting views.
    match /auditLogs/{auditLogId} {
      allow create: if (
        canManageWebJobs()
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == auditLogId
          && request.resource.data.actorId == request.auth.uid
          && (
            request.resource.data.action == 'job.status_updated'
            || request.resource.data.action == 'job_created'
            || request.resource.data.action == 'assignment_recommendations_generated'
            || request.resource.data.action == 'job_employees_assigned'
            || request.resource.data.action == 'job_employees_reassigned'
            || request.resource.data.action == 'job_employees_unassigned'
          )
          && request.resource.data.entityType == 'job'
          && (
            !(
              request.resource.data.action == 'job_created'
              || request.resource.data.action == 'assignment_recommendations_generated'
              || request.resource.data.action == 'job_employees_assigned'
              || request.resource.data.action == 'job_employees_reassigned'
              || request.resource.data.action == 'job_employees_unassigned'
            )
            || (
              request.resource.data.action == 'job_created'
              && request.resource.data.metadata.jobId == request.resource.data.entityId
            )
            || (
              request.resource.data.action == 'assignment_recommendations_generated'
              && request.resource.data.metadata.jobId == request.resource.data.entityId
              && request.resource.data.metadata.recommendationId is string
              && (request.resource.data.metadata.algorithmVersion == 'rule-based-v1' || request.resource.data.metadata.algorithmVersion == 'ahp-topsis-v1')
              && request.resource.data.metadata.assignmentMode == 'ai_recommendation'
              && request.resource.data.metadata.candidateCount is int
              && request.resource.data.metadata.candidateCount >= 0
              && request.resource.data.metadata.candidateCount <= 5
            )
            || (
              (
                request.resource.data.action == 'job_employees_assigned'
                || request.resource.data.action == 'job_employees_reassigned'
                || request.resource.data.action == 'job_employees_unassigned'
              )
              && (
                request.resource.data.metadata.jobId == request.resource.data.entityId
                && request.resource.data.metadata.previousEmployeeIds is list
                && request.resource.data.metadata.newEmployeeIds is list
                && (
                  (
                    request.resource.data.action == 'job_employees_assigned'
                    && request.resource.data.metadata.fromStatus == 'open'
                    && request.resource.data.metadata.toStatus == 'assigned'
                    && (
                      request.resource.data.metadata.assignmentMode == 'manual'
                      || (
                        request.resource.data.metadata.assignmentMode == 'ai_recommendation'
                        && request.resource.data.metadata.recommendationId is string
                        && request.resource.data.metadata.recommendedEmployeeId is string
                        && request.resource.data.metadata.selectedEmployeeId is string
                        && (
                          request.resource.data.metadata.decision == 'accepted'
                          || request.resource.data.metadata.decision == 'overridden'
                        )
                      )
                    )
                    && request.resource.data.metadata.newEmployeeIds.size() > 0
                  )
                  || (
                    request.resource.data.action == 'job_employees_reassigned'
                    && request.resource.data.metadata.fromStatus == 'assigned'
                    && request.resource.data.metadata.toStatus == 'assigned'
                    && request.resource.data.metadata.newEmployeeIds.size() > 0
                  )
                  || (
                    request.resource.data.action == 'job_employees_unassigned'
                    && request.resource.data.metadata.fromStatus == 'assigned'
                    && request.resource.data.metadata.toStatus == 'open'
                    && request.resource.data.metadata.newEmployeeIds == []
                  )
                )
              )
            )
          )
          && sameOrganization(request.resource.data.organizationId)
      ) || (
        isEmployee()
          && hasStandardBusinessFields(request.resource.data)
          && request.resource.data.id == auditLogId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.entityType == 'job'
          && (
            request.resource.data.action == 'job_started_by_employee'
            || request.resource.data.action == 'job_completed_by_employee'
          )
          && request.resource.data.metadata.employeeId == request.auth.uid
          && request.resource.data.metadata.performedAt is timestamp
          && request.resource.data.metadata.performedBy == request.auth.uid
          && request.resource.data.metadata.organizationId == request.resource.data.organizationId
          && request.resource.data.metadata.jobId == request.resource.data.entityId
          && employeeCanAccessJobId(request.resource.data.metadata.jobId)
          && (
            (
              request.resource.data.action == 'job_started_by_employee'
              && request.resource.data.metadata.fromStatus == 'assigned'
              && request.resource.data.metadata.toStatus == 'in_progress'
            )
            || (
              request.resource.data.action == 'job_completed_by_employee'
              && request.resource.data.metadata.fromStatus == 'in_progress'
              && request.resource.data.metadata.toStatus == 'completed'
            )
          )
          && sameOrganization(request.resource.data.organizationId)
      );
      allow get, list: if canManageWebJobs()
        && resource.data.isActive == true
        && sameOrganization(resource.data.organizationId);
      allow update, delete: if false;
    }

    // Future notifications rules:
    // - Rules will require sameOrganization(resource.data.organizationId).
    // - Users will read only their own notifications.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
