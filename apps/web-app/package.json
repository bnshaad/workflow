{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "evaluate:coordinator": "tsc -p tsconfig.test.json && node scripts/buildCoordinatorEvaluation.mjs && node node_modules/.tmp/coordinator-evaluation/runner.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "tsc -p tsconfig.test.json && node --import ./scripts/registerTestResolver.mjs --test \"$PWD\"/node_modules/.tmp/web-tests/apps/web-app/scripts/*.test.js",
    "seed:demo": "node scripts/seedDemoDataset.mjs",
    "seed:demo:emulator": "WORKFLOW_DEMO_SEED_ENABLED=true WORKFLOW_FIREBASE_ENV=development VITE_FIREBASE_PROJECT_ID=workflow-integration FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seedDemoDataset.mjs --with-auth-emulator --confirm=SEED_WORKFLOW_DEMO_SERVICES"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.1.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
