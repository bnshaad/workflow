{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "outDir": "./node_modules/.tmp/web-tests",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../..",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["scripts/*.ts"]
}
